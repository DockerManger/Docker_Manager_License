# ===== Docker Manager License 环境变量示例 =====
# 复制为 .env 并填写(生产环境权限 0600)

# PostgreSQL(compose 内联默认值见 deploy/docker-compose.yml)
POSTGRES_PASSWORD=请改成强密码

# JWT 签名密钥(必填,至少 32 字符随机串)
# 生成:openssl rand -hex 32
JWT_SECRET=

# 签发密钥标识(必填,如 2026-01;轮换时改成新标识)
LICENSE_KEY_ID=2026-01

# 首次初始化管理员(仅首次启动生效,初始化后从 .env 删除)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
