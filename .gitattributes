# 统一行尾为 LF(CI 在 Linux 上运行,gofmt/sh 均要求 LF)
*.go    text eol=lf
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
Dockerfile text eol=lf
Makefile  text eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.ico  binary
*.jpg  binary
*.woff binary
*.ttf  binary
